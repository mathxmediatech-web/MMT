# Password (wrap in quotes if it contains @, #, or special characters)
SMTP_PASS=mathxmedia@123

# From Address
SMTP_FROM=support@mathxmedia.tech

# Google Tag Manager Container ID
NEXT_PUBLIC_GTM_ID=GTM-WVFG9FLN

